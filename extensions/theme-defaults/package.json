{
	"name": "theme-defaults",
	"displayName": "%displayName%",
	"description": "%description%",
	"categories": [
		"Themes"
	],
	"version": "10.0.0",
	"publisher": "vscode",
	"license": "MIT",
	"engines": {
		"vscode": "*"
	},
	"contributes": {
		"themes": [
			{
				"id": "Tokyo Night",
				"label": "%tokyoNightThemeLabel%",
				"uiTheme": "vs-dark",
				"path": "./themes/tokyo-night-color-theme.json"
			}
		],
		"iconThemes": [
			{
				"id": "vs-nomo-dark",
				"label": "%nomoDarkIconThemeLabel%",
				"path": "./fileicons/nomo-dark.json"
			}
		]
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/vscode.git"
	}
}
